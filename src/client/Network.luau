				Events.Unreliable[0](Value)
			end
		end
	end
end)

local Returns = table.freeze {
	StepReplication = StepReplication,

	Action = {
		Invoke = function(Value: {
			name: (
				"Sync"
				| "Equip"
				| "Swing"
				| "Treadmill"
				| "PotOpen"
				| "PotClose"
				| "PotSet"
				| "Craft"
